[
  {
    "docId": "core-ai-overview",
    "title": "人工智能全景导论",
    "course": "人工智能课程",
    "module": "核心知识",
    "summary": "系统介绍人工智能的定义、主要分支、典型任务、能力边界和学习路线。",
    "keywords": [
      "人工智能",
      "AI",
      "机器学习",
      "深度学习",
      "大模型",
      "智能体"
    ],
    "content": "人工智能是让机器具备感知、理解、推理、学习、规划和行动能力的一组技术体系。它既包括经典的知识表示与搜索，也包括机器学习、深度学习、自然语言处理、计算机视觉和多模态系统。理解人工智能最重要的是建立层次关系：人工智能是总领域，机器学习是重要方法，深度学习是机器学习中的一类表示学习方法，大语言模型和生成式 AI 是近年的重要应用形态。当前 AI 擅长处理模式清晰、数据充分、评价目标明确的任务，但在事实一致性、长期规划、复杂世界模型和高风险决策可解释性上仍有明显限制。",
    "pdfPath": "core-ai-overview.pdf",
    "sourceType": "seed",
    "sourceLabel": "核心知识",
    "difficulty": "beginner",
    "recommendedTeachingGoals": [
      "建立 AI 总体知识地图",
      "理解 AI 与机器学习、深度学习、大模型的关系"
    ],
